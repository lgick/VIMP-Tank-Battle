div#auth

  div#auth-form

    h2= 'Tank Battle'

    div#auth-name.auth-field
      span= 'Name:'
      input#auth-name-input(type='text', name='name' maxlength='15', placeholder='Vanya')

    div#auth-error

    input#auth-enter(type='button', autofocus, value='Enter')

    div.auth-inform
      h4= 'Controls'
      p
        b= 'w, a, s, d'
        = ' - move the tank'
      p
        b= 'k, l'
        = ' - turn the gun'
      p
        b= 'u'
        = ' - center the gun'
      p
        b= 'j'
        = ' - fire'
      p.last
        b= 'n, p'
        = ' - switch weapon/player'
      p
        b= 'c'
        = ' - chat/command line'
      p
        b= 'm'
        = ' - menu'
      p.last
        b= '<Tab>'
        = ' - stats'

    div.auth-inform
      h4= 'Command line'
      p
        b= '/name <name>'
        = ' - change nickname'
      p
        b= '/mapname'
        = ' - show current map name'
      p
        b= '/timeleft'
        = ' - map time left'
      hr
      p
        b= '/bot <count>'
        = ' - add bot(s)'
      p
        b= '/bot <count> <team>'
        = ' - add to team'
      p
        b= '/bot 0'
        = ' - remove all bots'
      p
        b= '/bot 0 <team>'
        = ' - remove from team'

    div#auth-link
      p
        a(href='https://github.com/lgick/tank-battle') GitHub
      p &copy; #{new Date().getFullYear()} lgick
